procedure TWebForm2.SaveUserInfo;
const
  fname = '.\registros\dld_{0}.txt';
var
  filename, path : string;
  fs: FileStream;
  sw: StreamWriter;
begin
  filename := System.String.Format(fname, [System.Guid.NewGuid.ToString]);
  path := Server.MapPath(filename);
  fs := FileStream.Create(path, FileMode.Append, FileAccess.Write);
  try
    sw := StreamWriter.Create(fs);
    try
      sw.WriteLine(System.String.Format('{0}={1}', [TxbNome.ID,
        TxbNome.Text]));
      sw.WriteLine(System.String.Format('{0}={1}', [TxbFabricante.ID,
        TxbFabricante.Text]));
      sw.WriteLine(System.String.Format('{0}={1}', [TxbAno.ID,
        TxbAno.Text]));
      sw.WriteLine(System.String.Format('{0}={1}', [TxbValordeVenda.ID,
        TxbValordeVenda.Text]));
      sw.WriteLine(System.String.Format('{0}={1}', [TxbProprietario.ID,
        TxbProprietario.Text]));
      sw.WriteLine(System.String.Format('{0}={1}', [TxbTelefone.ID,
        TxbTelefone.Text]));
      sw.WriteLine(System.String.Format('{0}={1}', [Txbd.ID,
        Txbd.Text]));
      sw.WriteLine(System.String.Format('{0}={1}', [CBPermitEnvio.ID,
        CBPermitEnvio.Checked.ToString]));
    finally
    sw.Close;

    end;
  finally
  fs.Close;

  end;

end;

