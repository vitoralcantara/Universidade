procedure TWebForm1.Button2_Click(sender: System.Object; e: System.EventArgs);
const
  fname = '.\registros\{0}.txt';
  fimage ='.\images\{0}.jpg';

  var
  i : integer;
  filename : string;
  //fs : FileStream;
  sr : StreamReader;

  Line : string;
  FileLine: array of String;
  NameStr: String;
  ValueStr: String;
  caminho : String;

  begin
  for i := 0 to ListBox1.Items.Count - 1 do
  if ListBox1.Items[i].Selected then
  filename := ListBox1.Items.Item[i].Value;
  caminho := System.String.Format(fname,[filename]);
  Image2.ImageUrl := (System.String.Format(fimage,[filename]));

  if System.IO.File.Exists(caminho) then
  begin
    sr := StreamReader.Create(System.IO.File.OpenRead(caminho));
    try
        Line      := sr.ReadLine;         // Le uma Linha
        FileLine  := Line.Split(['=']);   // Split -> Extrai Valores separados por "="
        NameStr   := FileLine[0];
        ValueStr  := FileLine[1];

        TxbNome.Text   := ValueStr;
    finally
      sr.Close;



    end;
    TxbNome.Text   := ValueStr;
  end;






end;

